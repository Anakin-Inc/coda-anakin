{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["es2022"],
    "declaration": false,
    "outDir": "./dist",
    "skipLibCheck": true,
    "strict": true,
    "noImplicitAny": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "moduleResolution": "node",
    "baseUrl": "./",
    "experimentalDecorators": true
  },
  "include": ["./**/*.ts"],
  "exclude": ["./node_modules", "./dist"]
}
